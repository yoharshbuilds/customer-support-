# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# --- Postgres -------------------------------------------------------------
# Supabase: Connect -> "Session pooler" (NOT "Direct connection", which is
# IPv6-only, and NOT "Transaction pooler", which breaks prepared statements).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DB_MAX_CONNECTIONS=5

# --- Freshchat ------------------------------------------------------------
# Admin Settings -> API Tokens. Base MUST include the scheme and /v2.
FRESHCHAT_API_BASE=https://<your-account-subdomain>.freshchat.com/v2
FRESHCHAT_API_TOKEN=<long eyJ... JWT>

# --- Webhook auth (at least ONE of these is required) ---------------------
# Freshchat signs bodies with RSA-SHA256; paste the public key from the
# Freshchat webhook settings page. Single line with \n is fine.
FRESHCHAT_PUBLIC_KEY=
# Extra guard appended to the webhook URL as ?secret=...
WEBHOOK_SECRET=<long random string>
# Local testing only. NEVER set this on a public deployment.
ALLOW_UNVERIFIED_WEBHOOK=

# --- Claude ---------------------------------------------------------------
# Reads each resolved transcript: real issue, whether it was actually
# resolved, sentiment, and order ids the regex missed.
# Unset = review skipped; the dashboard still works on structured fields.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5. Override to switch models without a code change.
ANALYZE_MODEL=

# --- Metabase -------------------------------------------------------------
# Resolves CART ids to store + instant/deferred via rds_public.order_batches.
METABASE_URL=https://<your-metabase-host>
METABASE_API_KEY=
METABASE_DB_ID=7

# --- Behaviour ------------------------------------------------------------
# Salt for the customer dedupe digest. We store no phone numbers or names,
# only sha256(salt:phone). Keep this STABLE -- changing it makes historical
# rows stop matching new ones. Generate with: openssl rand -hex 32
CUSTOMER_HASH_SALT=
TIMEZONE=Asia/Kolkata
TOP_N_ISSUES=8
ENRICH_RETRY_SECONDS=120
